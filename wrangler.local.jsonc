{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"ratchet-rust-local",
  "main":"./crates/worker/build/index.js",
  "compatibility_date":"2026-10-15",
  "limits": { "cpu_ms": 30000 },
  "workers_dev":false,
  "assets":{"directory":"./dist/client","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":true},
  "r2_buckets":[{"binding":"ATTACHMENTS","bucket_name":"ratchet-rust-local-files"}],
  "triggers":{"crons":["*/5 * * * *"]},
  "durable_objects":{"bindings":[{"name":"CHAT_REALTIME","class_name":"ChatRealtime"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ChatRealtime"]}],
  "vars":{"APP_VERSION":"0.1.0-rust-local","RP_ORIGIN":"http://localhost:8797","RP_ID":"localhost"},
  "d1_databases":[{"binding":"DB","database_name":"ratchet-rust-local","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"db/migrations"}],
  "ratelimits":[
    {"name":"PUBLIC_RATE_LIMITER","namespace_id":"31015001","simple":{"limit":300,"period":60}},
    {"name":"AUTH_RATE_LIMITER","namespace_id":"31015002","simple":{"limit":60,"period":60}},
    {"name":"API_RATE_LIMITER","namespace_id":"31015003","simple":{"limit":1200,"period":60}},
    {"name":"WS_RATE_LIMITER","namespace_id":"31015004","simple":{"limit":60,"period":60}},
    {"name":"MESSAGE_RATE_LIMITER","namespace_id":"31015005","simple":{"limit":1200,"period":60}},
    {"name":"CUSTOMER_MESSAGE_BURST_RATE_LIMITER","namespace_id":"31015006","simple":{"limit":100,"period":10}},
    {"name":"CUSTOMER_MESSAGE_SUSTAINED_RATE_LIMITER","namespace_id":"31015007","simple":{"limit":600,"period":60}}
  ]
}
